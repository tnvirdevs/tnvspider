# PHPStan level 8 with WordPress stubs (szepeviktor/phpstan-wordpress,
# loaded by phpstan/extension-installer).
parameters:
	level: 8
	phpVersion: 80000
	paths:
		- wp-site-translator.php
		- uninstall.php
		- src
	treatPhpDocTypesAsCertain: false
	scanFiles:
		- tests/phpstan/wp-cli-stubs.php
		- tests/phpstan/cache-plugin-stubs.php
